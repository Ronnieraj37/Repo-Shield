# ── Required ────────────────────────────────────────────────────────────────
# Seals the session cookie that holds a GitHub token (AES-256-GCM).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Strongly recommended ────────────────────────────────────────────────────
# Raises the rate limit for the anonymous (no sign-in) path.
#
# This is close to mandatory in production. GitHub's anonymous limit is 60
# requests/hour *per source IP*, and a scan costs roughly 10 — so a deployed
# server without this serves about five anonymous scans an hour in total,
# shared across every visitor. With a token it is 5,000/hour.
#
# A classic personal access token with NO scopes ticked is enough: it only
# needs to raise the limit, never to read anything private.
GITHUB_TOKEN=

# Phase 2 of the pipeline. Without it, scans run static rules only and say so
# in the report rather than failing.
GEMINI_API_KEY=

# ── GitHub sign-in (needed only to scan private repositories) ───────────────
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Pin a specific Gemini model. Leave unset to use the built-in preference list,
# which races a strong model against a reliable one and takes the first answer.
# GEMINI_MODEL=gemini-3.6-flash

# The public origin, used to build the OAuth redirect_uri — which GitHub matches
# character for character against the callback URL registered on your OAuth App.
#
# Usually leave this UNSET. The app derives the origin from the request, and on
# Vercel from VERCEL_PROJECT_PRODUCTION_URL, so localhost and production are both
# correct with no configuration. Set it only when the public origin differs from
# the one requests arrive on — a custom domain in front of a proxy, say.
#
# Setting it to localhost and then deploying is the failure this replaced: the
# deployed app sent redirect_uri=http://localhost:3000/... to GitHub and every
# sign-in failed with "The redirect_uri is not associated with this application".
# NEXT_PUBLIC_APP_URL=

# ── Confidential scanning via Chainlink CRE (optional) ──────────────────────
# All three are required together; with any of them missing, the "Analyse
# inside a Chainlink CRE enclave" option does not appear and scans run locally.
#
# The gateway does not accept an API key. Requests are JSON-RPC, authenticated
# by a JWT signed with an EVM key whose address is listed in the workflow's
# `authorizedKeys` (cre/reposhield/config.*.json).
#
# Public (onchain) registry gateway:
#   https://01.gateway.zone-a.cre.chain.link
CRE_GATEWAY_URL=
# 64 hex characters, no 0x prefix — printed by `cre workflow deploy`.
CRE_WORKFLOW_ID=
# 0x-prefixed EVM private key. Its address must be in `authorizedKeys`.
CRE_SIGNER_PRIVATE_KEY=
