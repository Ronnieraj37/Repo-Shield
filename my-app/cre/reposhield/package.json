{
  "name": "reposhield-cre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RepoShield's analysis pipeline as a Chainlink CRE Confidential Workflow",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx test/run-confidential-scan.mts",
    "mock:server": "tsx ../mock-server.mts",
    "build": "cre workflow build . --target staging-settings --non-interactive",
    "simulate": "cre workflow simulate . --target staging-settings -e ../.env --http-payload ../payload.json"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "main": "dist/main.js"
}
