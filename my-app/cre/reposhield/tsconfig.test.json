{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": [
    "test/**/*.mts",
    "*.ts",
    "../../lib/analyzer/**/*.ts",
    "../../lib/github.ts",
    "../../lib/samples/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
